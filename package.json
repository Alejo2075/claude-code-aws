{
  "name": "claude-code-aws-workspace",
  "private": true,
  "description": "Workspace for independently installable Claude Code plugins for AWS development",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "check:versions": "tsx scripts/check-versions.ts",
    "check:changesets": "tsx scripts/check-changesets.ts",
    "check:template-markers": "tsx scripts/check-template-markers.ts",
    "build:release": "tsx scripts/build-release.ts",
    "test:packaging": "tsx tests/packaging/run.ts",
    "test:pipeline": "tsx scripts/selftest.ts",
    "new:plugin": "tsx scripts/new-plugin.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx scripts/sync-versions.ts && pnpm install --lockfile-only",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:versions && pnpm check:template-markers && pnpm validate && pnpm build:release && pnpm test:packaging && pnpm test:pipeline"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
