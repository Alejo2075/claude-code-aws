{
  "name": "aws-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Run, generate, and report tests for serverless apps: Lambda handlers, CDK assertions, and event fixtures for API Gateway, SQS, SNS, EventBridge, DynamoDB Streams, S3 and Step Functions. Never deploys.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx ../../scripts/build-plugin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@claude-code-aws/context-contract": "workspace:*",
    "@claude-code-aws/report-contract": "workspace:*",
    "@claude-code-aws/safe-output": "workspace:*",
    "@claude-code-aws/template-analysis": "workspace:*",
    "@claude-code-aws/testkit": "workspace:*",
    "@claude-code-aws/tool-runner": "workspace:*"
  }
}
