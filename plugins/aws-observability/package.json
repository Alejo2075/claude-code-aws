{
  "name": "aws-observability",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only operational visibility for serverless apps: Lambda and queue health, bounded logs and metrics, alarms, and an evidence ledger for incident investigation. Never changes anything.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx ../../scripts/build-plugin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "3.1161.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1161.0",
    "@aws-sdk/client-lambda": "3.1161.0",
    "@aws-sdk/client-sqs": "3.1161.0",
    "@aws-sdk/client-sts": "3.1158.0",
    "@claude-code-aws/aws-client": "workspace:*",
    "@claude-code-aws/context-contract": "workspace:*",
    "@claude-code-aws/report-contract": "workspace:*",
    "@claude-code-aws/safe-output": "workspace:*",
    "@claude-code-aws/testkit": "workspace:*"
  }
}
