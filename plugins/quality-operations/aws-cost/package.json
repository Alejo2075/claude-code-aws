{
  "name": "aws-cost",
  "version": "0.0.0",
  "private": true,
  "description": "Estimate and compare the monthly cost of serverless workloads from stated inputs and dated AWS list prices, clearly separate from billed amounts. Makes no AWS calls.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx ../../../scripts/build-plugin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-budgets": "3.1161.0",
    "@aws-sdk/client-cost-explorer": "3.1161.0",
    "@aws-sdk/client-sts": "3.1158.0",
    "@claude-code-aws/aws-client": "workspace:*",
    "@claude-code-aws/context-contract": "workspace:*",
    "@claude-code-aws/report-contract": "workspace:*",
    "@claude-code-aws/safe-output": "workspace:*",
    "@claude-code-aws/testkit": "workspace:*"
  }
}
